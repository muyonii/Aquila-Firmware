# ==============================================================================
# AQUILA Master Environment Configuration Template
# System: Distributed Multi-Agent Decision Support System (BPSU BSCS SD3B 2026)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SMS GATEWAY CONFIGURATION (Semaphore / Twilio)
# ------------------------------------------------------------------------------
SMS_PROVIDER=semaphore               # Options: semaphore, twilio, demo
SEMAPHORE_API_KEY=your_semaphore_api_key_here
SEMAPHORE_SENDER_NAME=AQUILA

# ------------------------------------------------------------------------------
# 2. EMAIL GATEWAY CONFIGURATION (SMTP / Gmail / SendGrid)
# ------------------------------------------------------------------------------
MAIL_DRIVER=smtp                     # Options: smtp, mail, demo
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@bawasa.gov.ph
MAIL_FROM_NAME="AQUILA Water System"

# ------------------------------------------------------------------------------
# 1. APPLICATION & SYSTEM ENVIRONMENT
# ------------------------------------------------------------------------------
APP_NAME=AQUILA
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
DEMO_MODE=true

# ------------------------------------------------------------------------------
# 2. RELATIONAL DATABASE (MySQL 8.0 / XAMPP)
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=aquila_db
DB_USER=aquila_app
DB_PASS=AquilaSecurePass2026!
DB_TIMEZONE=+08:00

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & CRYPTOGRAPHIC SECRETS
# ------------------------------------------------------------------------------
# Secret key used for signing JWT Bearer Tokens (HMAC-SHA256)
JWT_SECRET=aquila_super_secret_jwt_key_bpsu_2026
JWT_EXPIRATION_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_SECONDS=3600
OTP_TTL_MINUTES=10

# Pre-shared cryptographic secret for internal agent-to-PHP webhook (HMAC-SHA256)
WEBHOOK_SECRET=aquila_internal_hmac_secret_key_2026

# ------------------------------------------------------------------------------
# 4. CLOUD HOT STORE & MULTI-AGENT BLACKBOARD (Firebase RTDB)
# ------------------------------------------------------------------------------
# Free Spark Plan Instance (Singapore region: asia-southeast1)
FIREBASE_DATABASE_URL=https://aquila-system-default-rtdb.asia-southeast1.firebasedatabase.app

# ------------------------------------------------------------------------------
# 5. SERVER-TO-SERVER INTERNAL LOOPBACK IPC
# ------------------------------------------------------------------------------
# Must use 127.0.0.1 to avoid Windows IPv6 (::1) connection refusal in Node.js
BACKEND_WEBHOOK_URL=http://127.0.0.1/aquila-system/backend-api/public/api/v1/webhooks/incident

# ------------------------------------------------------------------------------
# 6. FRONTEND CLIENT CONFIGURATION (React 18 / Vite)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://127.0.0.1/aquila-system/backend-api/public/api/v1
VITE_FIREBASE_DATABASE_URL=https://aquila-system-default-rtdb.asia-southeast1.firebasedatabase.app

#------------------------------------------------------------------------------
# 7. DEMO CADENCE & COMPACTION
# ------------------------------------------------------------------------------
# 30000ms (30s) during live demonstration; 300000ms (5 mins) in production
SQL_COMPACTION_INTERVAL_MS=30000

# ------------------------------------------------------------------------------
# 8. OPERATIONAL & ALGORITHMIC THRESHOLDS (Phase 05 / 14 Baseline)
# ------------------------------------------------------------------------------
TELEMETRY_INTERVAL_SECONDS=15
REPAIR_VERIFICATION_SECONDS=900
QUIESCENT_FLOW_FLOOR_LPM=0.05
MECHANICAL_SENSOR_FLOOR_LPM=1.0
LOW_BATTERY_THRESHOLD_VOLTS=3.35
STALE_TELEMETRY_TIMEOUT_SECONDS=45
RAWLSIAN_RDI_CUTOFF=0.70
MUNICIPAL_SHORTAGE_FLOOR_LPD=50.0
CIRCUIT_BREAKER_TIMEOUT_SECONDS=30.0
PERSONAL_DEFICIT_THRESHOLD=0.60